---
import { Box, ExternalLink } from '@lucide/astro';
import { u } from '../lib/url';
import { imageSize } from '../lib/media';

interface Props {
  title: string;
  href: string;
  description?: string;
  preview?: string;
  category?: string;
  file?: string;
  /** Where the files live when they aren't hosted here (Printables, GitHub). */
  source?: string;
  /** Designer, when the model isn't mine — shown so attribution is visible
   *  on the grid, not only after clicking through. */
  credit?: string;
  licence?: string;
  /** h2 on list pages, h3 under the hub's section headings. */
  headingLevel?: 2 | 3;
}

const {
  title,
  href,
  description = '',
  preview = '',
  category = '',
  file = '',
  source = '',
  credit = '',
  licence = '',
  headingLevel = 3,
} = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const src = preview ? u(preview) : '';
const dims = preview ? await imageSize(preview, '/images') : null;
// A model with no local file downloads from somewhere else. Saying so on the
// card sets the expectation before the click — the grid icon changes too, so
// "ready to print" and "hosted elsewhere" never look interchangeable.
const external = !file && Boolean(source);
const host = source.includes('printables') ? 'on Printables' : 'hosted elsewhere';
---

<a class="card" href={u(href)}>
  <div class="card__media model-media">
    {
      src ? (
        <img src={src} alt="" width={dims?.w} height={dims?.h} loading="lazy" decoding="async" />
      ) : (
        <>
          <span class="model-media__grid" aria-hidden="true" />
          {external ? (
            <ExternalLink class="model-media__icon" size={54} stroke-width={1.25} aria-hidden="true" />
          ) : (
            <Box class="model-media__icon" size={54} stroke-width={1.25} aria-hidden="true" />
          )}
        </>
      )
    }
  </div>
  <div class="card__body">
    <p class="card__meta">
      {category ? <span class="pill">{category}</span> : <span>3D model</span>}
      {file && <span>· ready to print</span>}
      {external && <span>· {host}</span>}
    </p>
    <Heading class="card__title">{title}</Heading>
    {description && <p class="card__summary">{description}</p>}
    {
      credit && (
        <p class="card__credit">
          Designed by {credit}
          {licence && <span> · {licence}</span>}
        </p>
      )
    }
    <span class="card__foot">View model →</span>
  </div>
</a>

<style>
  .model-media {
    display: grid;
    place-items: center;
    position: relative;
    background:
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 26px 26px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 26px 26px,
      var(--panel);
  }

  .model-media__icon {
    color: var(--accent);
    position: relative;
  }
</style>
