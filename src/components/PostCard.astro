---
import { u } from '../lib/url';

interface Props {
  title: string;
  href: string;
  date: Date;
  mins?: number;
  summary?: string;
  /** h2 on list pages, h3 under the hub's section headings. */
  headingLevel?: 2 | 3;
}

const { title, href, date, mins = 0, summary = '', headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const formatted = new Date(date).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<a class="card" href={u(href)}>
  <div class="card__body">
    <p class="card__meta">
      <time datetime={date.toISOString()}>{formatted}</time>
      {mins > 0 && <span>· {mins} min read</span>}
    </p>
    <Heading class="card__title">{title}</Heading>
    {summary && <p class="card__summary">{summary}</p>}
    <span class="card__foot">Read →</span>
  </div>
</a>
