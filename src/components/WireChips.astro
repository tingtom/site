---
import { wireStyle } from '../lib/wire-color';

interface Props {
  colors: string[];
  /**
   * Colours this page has a traced wire for. They render as buttons that light
   * the line up on the drawing; the rest stay plain text, because a chip that
   * promises a highlight and shows nothing is worse than one that does not.
   */
  linked?: Set<string>;
}

const { colors, linked } = Astro.props;
---

{
  colors.length > 0 && (
    <div class="wire-chips">
      {colors.map((c) => {
        const style = wireStyle(c);
        return linked?.has(c) ? (
          <button
            type="button"
            class="wire-chip"
            data-region={c}
            aria-label={`${c} — show this wire on the diagram`}
            style={style ?? undefined}
          >
            {c}
          </button>
        ) : (
          <span class="wire-chip" style={style ?? undefined}>
            {c}
          </span>
        );
      })}
    </div>
  )
}
---

<style>
  .wire-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .wire-chip {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    /* fallback for colours we don't recognise */
    background: var(--panel);
    color: var(--fg-muted);
    border: 1px solid var(--line);
    /* the ones that trace a wire are buttons: reset the UA's chrome so they
       keep looking exactly like the ones that do not */
    appearance: none;
    line-height: inherit;
    text-align: inherit;
    cursor: pointer;
  }

  .wire-chip[style] {
    /* keep the 1px outline on coloured chips too — a black wire would
       otherwise vanish into the panel behind it */
    border-color: var(--line);
  }

  button.wire-chip:hover,
  button.wire-chip.is-marked {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 35%, transparent);
  }

  button.wire-chip:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
