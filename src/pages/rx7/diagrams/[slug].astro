---
import { getCollection } from 'astro:content';
import { slug } from '../../../lib/slug';
import Base from '../../../layouts/Base.astro';
import WireChips from '../../../components/WireChips.astro';
import { u } from '../../../lib/url';
import { asset, diagramSrc, diagramSize } from '../../../lib/media';

export async function getStaticPaths() {
  const diagrams = (await getCollection('diagrams')).filter((d) =>
    d.data.sections.includes('rx7'),
  );
  return diagrams.map((diagram) => ({
    params: { slug: slug(diagram) },
    props: { diagram },
  }));
}

const { diagram } = Astro.props;
const d = diagram.data;
const hasMeta = Boolean(d.category || d.components.length || d.connectors.length);
---

<Base
  title={d.title}
  description={d.description || `RX7 wiring diagram — ${d.title}`}
  section="rx7"
>
  <main>
    <div class="wrap">
      <a class="backlink" href="/rx7/diagrams/">← All diagrams</a>

      <div class="diagram-layout">
        <div class="diagram-images">
          <h1>{d.title}</h1>

          {
            d.images.map((img, i) => (
              <figure class="diagram-figure">
                <a href={asset(img, '/diagrams')} target="_blank" rel="noopener">
                  <img
                    src={diagramSrc(img, 'view')}
                    alt={`${d.title}${d.images.length > 1 ? ` — page ${i + 1}` : ''}`}
                    width={diagramSize(img)?.w}
                    height={diagramSize(img)?.h}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </a>
                <figcaption>
                  {d.images.length > 1 ? `Page ${i + 1} of ${d.images.length}` : 'Scan'} ·{' '}
                  <a href={asset(img, '/diagrams')} target="_blank" rel="noopener">
                    full resolution →
                  </a>
                </figcaption>
              </figure>
            ))
          }
        </div>

        <aside class="diagram-meta">
          <div class="diagram-meta__inner">
            <p class="card__meta">
              {d.category && <span class="pill">{d.category}</span>}
              {d.yearRange &&
                d.yearRange.split(',').map((y) => <span class="pill pill--quiet">{y.trim()}</span>)}
              {d.identifier && <span class="pill pill--quiet">ID {d.identifier}</span>}
            </p>

            {d.description && <p class="diagram-desc">{d.description}</p>}

            {
              hasMeta ? (
                <div class="meta-stack">
                  {d.wireColors.length > 0 && (
                    <section class="meta-block">
                      <h2>Wire colours</h2>
                      <WireChips colors={d.wireColors} />
                    </section>
                  )}

                  {d.components.length > 0 && (
                    <section class="meta-block">
                      <h2>Components</h2>
                      <ul>
                        {d.components.map((v) => (
                          <li>{v}</li>
                        ))}
                      </ul>
                    </section>
                  )}

                  {d.connectors.length > 0 && (
                    <section class="meta-block">
                      <h2>Connectors</h2>
                      <ul>
                        {d.connectors.map((v) => (
                          <li>{v}</li>
                        ))}
                      </ul>
                    </section>
                  )}

                  {d.ecuPins.length > 0 && (
                    <section class="meta-block">
                      <h2>ECU pins</h2>
                      <ul>
                        {d.ecuPins.map((v) => (
                          <li>{v}</li>
                        ))}
                      </ul>
                    </section>
                  )}

                  {d.notes && (
                    <section class="meta-block">
                      <h2>Notes</h2>
                      <p class="muted">{d.notes}</p>
                    </section>
                  )}

                  {typeof d.confidence === 'number' && (
                    <p class="confidence">
                      Extracted with {Math.round(d.confidence * 100)}% confidence
                    </p>
                  )}
                </div>
              ) : (
                <p class="muted meta-note">
                  Metadata hasn't been extracted for this scan yet — it's browse-only until it's run
                  through the processor.
                </p>
              )
            }
          </div>
        </aside>
      </div>
    </div>
  </main>
</Base>

<style>
  .diagram-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 340px);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }

  .diagram-images h1 {
    font-size: clamp(1.6rem, 3.2vw, 2.4rem);
    margin-bottom: 1.5rem;
  }

  .diagram-figure {
    margin: 0 0 1.5rem;
  }

  /* direct child only: the caption contains its own link, which must keep the
     page background — a white box under muted grey text failed contrast */
  .diagram-figure > a {
    display: block;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
  }

  .diagram-figure img {
    width: 100%;
  }

  .diagram-figure figcaption {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-top: 0.5rem;
  }

  .diagram-meta {
    position: sticky;
    top: 1rem;
  }

  .diagram-meta__inner {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
    padding: 1.25rem;
    display: grid;
    gap: 1.15rem;
  }

  .diagram-desc {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.97rem;
  }

  .meta-stack {
    display: grid;
    gap: 1.15rem;
  }

  .meta-block h2 {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.55rem;
  }

  .meta-block ul {
    list-style: none;
    margin: 0;
    padding: 0.65rem 0.8rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    font-size: 0.9rem;
    display: grid;
    gap: 0.3rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .meta-block p {
    margin: 0;
    font-size: 0.92rem;
  }

  .confidence,
  .meta-note {
    margin: 0;
    font-size: 0.83rem;
  }

  @media (max-width: 900px) {
    .diagram-layout {
      grid-template-columns: 1fr;
    }

    .diagram-meta {
      position: static;
    }
  }
</style>
