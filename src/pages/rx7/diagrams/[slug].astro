---
import { getCollection } from 'astro:content';
import { slug } from '../../../lib/slug';
import Base from '../../../layouts/Base.astro';
import WireChips from '../../../components/WireChips.astro';
import DiagramEntries from '../../../components/DiagramEntries.astro';
import { u } from '../../../lib/url';
import { asset, diagramSrc, diagramSize, diagramEn, diagramEnSize, diagramTranslation } from '../../../lib/media';
import { diagramRegions, diagramWires, tracedColours, KIND_NOUN } from '../../../lib/regions';

export async function getStaticPaths() {
  const diagrams = (await getCollection('diagrams')).filter((d) =>
    d.data.sections.includes('rx7'),
  );
  return diagrams.map((diagram) => ({
    params: { slug: slug(diagram) },
    props: { diagram },
  }));
}

const { diagram } = Astro.props;
const d = diagram.data;
const hasMeta = Boolean(d.category || d.components.length || d.connectors.length);

// Which sidebar entries have somewhere to point at. Only those become links:
// an entry without a located region stays plain text rather than offering a
// jump that goes nowhere.
const entryNames = new Set([...d.components, ...d.connectors, ...d.ecuPins]);
const rawRegions = d.images.map((img) => diagramRegions(img));
const located = new Set(
  rawRegions.flat().map((r) => r.label).filter((label) => entryNames.has(label)),
);

// Stable ids let the two sides link to each other with plain anchors, so
// keyboard focus, click-to-reveal and scrolling all work without JavaScript.
const entryId = (kind: string, i: number) => `entry-${kind}-${i}`;
const entryAnchor = new Map<string, string>();
for (const [kind, list] of [
  ['component', d.components],
  ['connector', d.connectors],
  ['ecuPin', d.ecuPins],
] as const) {
  list.forEach((v, i) => {
    if (located.has(v) && !entryAnchor.has(v)) entryAnchor.set(v, entryId(kind, i));
  });
}

// Only regions whose label has a sidebar entry are drawn: a box the sidebar
// cannot name would be a highlight with nothing to say.
const pageRegions = rawRegions.map((rs) => rs.filter((r) => entryAnchor.has(r.label)));
const regionAnchor = new Map<string, string>();
pageRegions.forEach((rs, i) =>
  rs.forEach((r, ri) => {
    if (!regionAnchor.has(r.label)) regionAnchor.set(r.label, `region-${i}-${ri}`);
  }),
);
const anchors = Object.fromEntries(entryAnchor);
const regionAnchors = Object.fromEntries(regionAnchor);

// Wire traces are per image; the chip list is page-level, so a chip lights any
// of its runs on whichever page shows them.
const pageWires = d.images.map((img) => diagramWires(img));
const linkedColours = tracedColours(pageWires.flat());
const pct = (n: number) => `${+(n * 100).toFixed(3)}%`;
---

<Base
  title={d.title}
  description={d.description || `RX7 wiring diagram — ${d.title}`}
  section="rx7"
>
  <main>
    <div class="wrap">
      <a class="backlink" href={u('/rx7/diagrams/')}>← All diagrams</a>

      <div class="diagram-layout">
        <div class="diagram-images">
          <h1>{d.title}</h1>

          {
            d.images.map((img, i) => {
              // The English build replaces the scan when one exists, keyed by
              // page; four harness pages have none yet and say so instead.
              const en = diagramEn(img);
              const origin = diagramTranslation(img);
              const size = en ? diagramEnSize(img) : diagramSize(img);
              const page = d.images.length > 1 ? ` — page ${i + 1}` : '';
              const kind =
                origin === 'machine'
                  ? 'Machine-translated'
                  : en
                    ? 'English translation'
                    : 'Japanese scan';
              const altKind =
                origin === 'machine' ? 'machine-translated English' : en ? 'English translation' : 'Japanese scan';
              const regions = pageRegions[i];
              const wires = pageWires[i];
              // A page can be interactive because of boxes, or because of
              // traced wires, or both: either way the image leaves its link and
              // sits in the frame the overlay is drawn over.
              const linked = regions.length > 0 || wires.length > 0;
              const fullHref = asset(img, '/diagrams');

              return (
                <figure class:list={['diagram-figure', linked && 'diagram-figure--linked']}>
                  {linked ? (
                    // The image is no longer wrapped in a link on these pages:
                    // the regions are links themselves, and an anchor inside an
                    // anchor is invalid and unreachable. The caption carries the
                    // full-resolution link instead.
                    <div class="diagram-frame">
                      <img
                        src={en ?? diagramSrc(img, 'view')}
                        alt={`${d.title}${page} — ${altKind}`}
                        width={size?.w}
                        height={size?.h}
                        loading={i === 0 ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                      {wires.length > 0 && (
                        // Fractions of the image in a 0..1 viewBox, non-scaling
                        // stroke: the line keeps its weight whatever the figure
                        // is scaled to, and the layer is absolutely positioned
                        // inside the image's reserved box, so it shifts nothing.
                        <svg
                          class="wire-layer"
                          viewBox="0 0 1 1"
                          preserveAspectRatio="none"
                          aria-hidden="true"
                        >
                          {wires.map((w) => (
                            <polyline
                              class="wire"
                              data-region={w.label}
                              points={w.points.map(([x, y]) => `${x},${y}`).join(' ')}
                            />
                          ))}
                        </svg>
                      )}
                      <div class="region-layer">
                        {regions.map((r, ri) => (
                          <a
                            class="region"
                            id={`region-${i}-${ri}`}
                            href={`#${entryAnchor.get(r.label)}`}
                            data-region={r.label}
                            aria-label={`${r.label} — ${KIND_NOUN[r.kind]} on this diagram`}
                            style={`left:${pct(r.x)};top:${pct(r.y)};width:${pct(r.w)};height:${pct(r.h)}`}
                          >
                            <span class="region-tag">{r.label}</span>
                          </a>
                        ))}
                      </div>
                    </div>
                  ) : (
                    <a href={en ?? fullHref} target="_blank" rel="noopener">
                      <img
                        src={en ?? diagramSrc(img, 'view')}
                        alt={`${d.title}${page} — ${altKind}`}
                        width={size?.w}
                        height={size?.h}
                        loading={i === 0 ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                    </a>
                  )}
                  <figcaption>
                    {d.images.length > 1 ? `Page ${i + 1} of ${d.images.length} · ` : ''}
                    {kind} ·{' '}
                    <a href={fullHref} target="_blank" rel="noopener">
                      {en ? 'original Japanese scan →' : 'full resolution →'}
                    </a>
                    {linked && (
                      <>
                        {' · '}
                        <a href={en ?? fullHref} target="_blank" rel="noopener">
                          full resolution →
                        </a>
                      </>
                    )}
                  </figcaption>
                  {linked && (
                    <p class="region-hint">
                      Hover, focus or tap a boxed area to see what it is — it links to the matching
                      entry in the sidebar.
                      {wires.length > 0 &&
                        ' Wire colours with a traced line do the same; the dashed ones have no single wire to point at on this page.'}
                    </p>
                  )}
                </figure>
              );
            })
          }
        </div>

        <aside class="diagram-meta">
          <div class="diagram-meta__inner">
            <p class="card__meta">
              {d.category && <span class="pill">{d.category}</span>}
              {d.yearRange &&
                d.yearRange.split(',').map((y) => <span class="pill pill--quiet">{y.trim()}</span>)}
              {d.identifier && <span class="pill pill--quiet">ID {d.identifier}</span>}
            </p>

            {d.description && <p class="diagram-desc">{d.description}</p>}

            {
              hasMeta ? (
                <div class="meta-stack">
                  {d.wireColors.length > 0 && (
                    <section class="meta-block">
                      <h2>Wire colours</h2>
                      <WireChips colors={d.wireColors} linked={linkedColours} />
                    </section>
                  )}

                  {d.components.length > 0 && (
                    <section class="meta-block">
                      <h2>Components</h2>
                      <DiagramEntries items={d.components} kind="component" anchors={anchors} regionAnchors={regionAnchors} />
                    </section>
                  )}

                  {d.connectors.length > 0 && (
                    <section class="meta-block">
                      <h2>Connectors</h2>
                      <DiagramEntries items={d.connectors} kind="connector" anchors={anchors} regionAnchors={regionAnchors} />
                    </section>
                  )}

                  {d.ecuPins.length > 0 && (
                    <section class="meta-block">
                      <h2>ECU pins</h2>
                      <DiagramEntries items={d.ecuPins} kind="ecuPin" anchors={anchors} regionAnchors={regionAnchors} />
                    </section>
                  )}

                  {d.notes && (
                    <section class="meta-block">
                      <h2>Notes</h2>
                      <p class="muted">{d.notes}</p>
                    </section>
                  )}

                  {typeof d.confidence === 'number' && (
                    <p class="confidence">
                      Extracted with {Math.round(d.confidence * 100)}% confidence
                    </p>
                  )}
                </div>
              ) : (
                <p class="muted meta-note">
                  Metadata hasn't been extracted for this scan yet — it's browse-only until it's run
                  through the processor.
                </p>
              )
            }
          </div>
        </aside>
      </div>
    </div>
  </main>
</Base>

<script>
  // Everything that stands for the same thing is one group: a sidebar entry, a
  // box on the drawing, a wire colour chip and the line that chip draws.
  const partners = new Map();
  for (const el of document.querySelectorAll('[data-region]')) {
    const label = el.dataset.region;
    const group = partners.get(label);
    if (group) group.push(el);
    else partners.set(label, [el]);
  }
  const mark = (label, on) => {
    for (const el of partners.get(label) ?? []) el.classList.toggle('is-marked', on);
  };

  for (const el of document.querySelectorAll('[data-region]')) {
    const label = el.dataset.region;
    // Focus works the same for all of them: keyboard is how a box on the
    // drawing is reached without a pointer at all.
    el.addEventListener('focus', () => mark(label, true));
    el.addEventListener('blur', () => mark(label, false));
    // Chips and lines take the pointer themselves; the boxes do not (see
    // pointer-events in the styles), so they are picked by the frame below.
    if (el.classList.contains('region')) continue;
    el.addEventListener('pointerenter', () => mark(label, true));
    el.addEventListener('pointerleave', () => mark(label, false));
  }

  // A hover highlight is only true while the pointer is over the thing. Scroll
  // the page under a stationary pointer and the browser sends no new pointer
  // events, so a chip's line would stay lit with the chip long gone. Focus is a
  // real state, so a mark on a group that holds the focus survives.
  const clearHoverMarks = () => {
    const focused = document.activeElement;
    for (const el of document.querySelectorAll('.is-marked')) {
      const group = partners.get(el.dataset.region) ?? [];
      if (focused && group.includes(focused)) continue;
      el.classList.remove('is-marked');
    }
  };
  window.addEventListener('scroll', clearHoverMarks, { passive: true });
  window.addEventListener('resize', clearHoverMarks, { passive: true });

  for (const frame of document.querySelectorAll('.diagram-frame')) {
    let boxes = null;
    let active = null;

    // Client coordinates against the frame, in frame pixels — measured per
    // gesture rather than per pointer event, and dropped on scroll or resize
    // because every rect moves with them.
    const measure = () => {
      const f = frame.getBoundingClientRect();
      boxes = [...frame.querySelectorAll('.region')].map((el) => {
        const b = el.getBoundingClientRect();
        return {
          el,
          label: el.dataset.region,
          l: b.left - f.left,
          t: b.top - f.top,
          r: b.right - f.left,
          b: b.bottom - f.top,
          area: b.width * b.height,
        };
      });
    };

    // Smallest box containing the point wins: where a cluster of labels
    // overlaps, the specific one is what the reader is pointing at.
    const pick = (ev) => {
      if (!boxes) measure();
      const f = frame.getBoundingClientRect();
      const x = ev.clientX - f.left;
      const y = ev.clientY - f.top;
      let best = null;
      for (const b of boxes) {
        if (x >= b.l && x <= b.r && y >= b.t && y <= b.b && (!best || b.area < best.area)) best = b;
      }
      return best;
    };

    frame.addEventListener('pointerenter', () => {
      boxes = null;
    });

    // Drop whatever is lit. `active` is the box element, so its label is what
    // the group is keyed by — passing the element itself matched nothing and
    // left the tag on screen after the pointer had gone (the bug).
    const clear = () => {
      if (active) mark(active.dataset.region, false);
      active = null;
    };

    frame.addEventListener('pointermove', (ev) => {
      const hit = pick(ev);
      if (hit?.el === active) return;
      clear();
      if (!hit) return;
      active = hit.el;
      mark(hit.label, true);
    });
    frame.addEventListener('pointerleave', () => {
      clear();
      boxes = null;
    });
    // Tap or click a box: jump to the entry it belongs to, the same thing the
    // anchor's href would do if the box could take the pointer.
    frame.addEventListener('click', (ev) => {
      const hit = pick(ev);
      const entry = hit ? document.getElementById(hit.el.getAttribute('href').slice(1)) : null;
      if (!entry) return;
      ev.preventDefault();
      entry.focus();
      entry.scrollIntoView({ block: 'nearest' });
    });

    // The boxes are measured against the frame, so they are stale after either
    // — and the pointer is now over different content, so nothing should stay
    // lit either.
    const reset = () => {
      clear();
      boxes = null;
    };
    window.addEventListener('scroll', reset, { passive: true });
    window.addEventListener('resize', reset, { passive: true });
  }
</script>

<style>
  .diagram-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 340px);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }

  .diagram-images h1 {
    font-size: clamp(1.6rem, 3.2vw, 2.4rem);
    margin-bottom: 1.5rem;
  }

  .diagram-figure {
    margin: 0 0 1.5rem;
  }

  /* direct child only: the caption contains its own link, which must keep the
     page background — a white box under muted grey text failed contrast */
  .diagram-figure > a {
    display: block;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
  }

  /* The frame reserves the image's own aspect ratio through the img's width
     and height attributes, so painting regions over it adds no layout and no
     shift. No overflow:hidden either — a tag near an edge has to be able to
     escape the frame's edge. */
  .diagram-frame {
    position: relative;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    line-height: 0;
  }

  .diagram-figure img {
    width: 100%;
    display: block;
  }

  .diagram-frame img {
    border-radius: calc(var(--radius) - 1px);
  }

  .region-layer {
    position: absolute;
    inset: 0;
    /* only the boxes themselves take the pointer, so the drawing stays
       inspectable between them */
    pointer-events: none;
  }

  /* Traced wires: drawn only while their chip is pointed at or focused, so the
     page is never covered in red. The layer ignores the pointer but each line
     takes it back for its own stroke — pointing at the wire marks its chip. */
  .wire-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .wire {
    fill: none;
    stroke: transparent;
    stroke-width: 3;
    stroke-linejoin: round;
    stroke-linecap: round;
    /* the viewBox is 0..1 while the image is hundreds of pixels wide, so
       without this the stroke would be a hairline or a band depending on the
       figure's size */
    vector-effect: non-scaling-stroke;
    pointer-events: stroke;
    transition:
      stroke 0.12s ease,
      stroke-width 0.12s ease;
  }

  .wire:hover,
  .wire.is-marked {
    stroke: var(--accent);
    stroke-width: 4;
  }

  .region {
    position: absolute;
    display: block;
    /* No pointer events of their own. The boxes overlap on a dense page (the
       diagram has 21 overlapping pairs), and axe — WCAG 2.5.8 — counts every
       overlapping focusable element as eating into its neighbour's clickable
       area, so none of them could ever be 24x24 of *unobscured* space. It also
       excludes neighbours whose pointer-events is `none`. The frame below does
       the picking instead, which gives one deterministic target per point. */
    pointer-events: none;
    /* The drawn box is ::after, at the exact fraction; the link itself carries
       12px of padding so its rectangle is never under 24x24 CSS px (WCAG 2.5.8)
       — the smallest labels on an 1800px scan are a few pixels tall when the
       page shows it a few hundred wide, so without this they fail on size too. */
    padding: 12px;
    margin: -12px 0 0 -12px;
    border: 0;
    background: none;
    scroll-margin-top: 5rem;
  }

  .region::after {
    content: '';
    position: absolute;
    inset: 12px;
    border: 2px solid transparent;
    border-radius: 4px;
    transition:
      background-color 0.12s ease,
      border-color 0.12s ease;
  }

  .region:hover::after,
  .region.is-marked::after,
  .region:target::after {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
  }

  .region:focus-visible {
    outline: none;
  }

  .region:focus-visible::after {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .region-tag {
    position: absolute;
    top: calc(100% - 8px);
    left: 10px;
    z-index: 2;
    display: none;
    max-width: 22rem;
    padding: 0.2rem 0.45rem;
    border-radius: 5px;
    background: var(--fg);
    color: var(--bg-elev);
    border: 1px solid color-mix(in srgb, var(--fg) 20%, var(--bg-elev));
    box-shadow: 0 3px 10px rgb(0 0 0 / 0.28);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .region:hover .region-tag,
  .region:focus-visible .region-tag,
  .region.is-marked .region-tag,
  .region:target .region-tag {
    display: block;
  }

  .region-hint {
    margin: 0.45rem 0 0;
    font-size: 0.83rem;
    color: var(--fg-muted);
  }

  .diagram-figure figcaption {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-top: 0.5rem;
  }

  .diagram-meta {
    position: sticky;
    top: 1rem;
  }

  .diagram-meta__inner {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
    padding: 1.25rem;
    display: grid;
    gap: 1.15rem;
  }

  .diagram-desc {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.97rem;
  }

  .meta-stack {
    display: grid;
    gap: 1.15rem;
  }

  .meta-block h2 {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.55rem;
  }

  .meta-block p {
    margin: 0;
    font-size: 0.92rem;
  }

  .confidence,
  .meta-note {
    margin: 0;
    font-size: 0.83rem;
  }

  @media (max-width: 900px) {
    .diagram-layout {
      grid-template-columns: 1fr;
    }

    .diagram-meta {
      position: static;
    }
  }
</style>
