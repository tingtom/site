---
import { getCollection, render } from 'astro:content';
import { slug } from '../../../lib/slug';
import Base from '../../../layouts/Base.astro';
import { u } from '../../../lib/url';

export async function getStaticPaths() {
  const models = (await getCollection('models')).filter((m) =>
    m.data.sections.includes('rx7'),
  );
  return models.map((model) => ({
    params: { slug: slug(model) },
    props: { model },
  }));
}

const { model } = Astro.props;
const m = model.data;
const { Content } = await render(model);

const hasFile = Boolean(m.file);
const fileUrl = hasFile ? u(m.file) : '';
const ext = hasFile ? (m.file!.split('.').pop()?.toLowerCase() ?? 'stl') : '';

// Every download on the page: the previewed file first, then the rest of the
// set. `files` carries what the single `file` field cannot — the other side
// of a pair, STEP originals, a zip, print notes. When `files` already names
// the previewed file, keep its wording ("Left — STL") rather than falling
// back to a bare "Download STL" next to a "Download Right — STL".
//
// With no local file the model lives on someone else's site: `files` becomes
// the whole list, led by whatever it points at.
const named = (m.files ?? []).find((f) => f.href === m.file);
const source = hasFile
  ? [
      {
        label: named ? `Download ${named.label}` : `Download ${ext.toUpperCase()}`,
        href: m.file!,
        note: named?.note ?? 'previewed above',
      },
      ...(m.files ?? [])
        .filter((f) => f.href !== m.file)
        .map((f) => ({ ...f, label: `Download ${f.label}` })),
    ]
  : // No local file: the labels are already written for it ("Download on
    // Printables"), so they go through unchanged.
    (m.files ?? []).map((f) => ({ ...f }));

// No file means no mesh to orbit: swap the viewer for a panel that says where
// the files actually are, rather than showing a broken preview.
const viewerNote = hasFile
  ? 'Loading 3D preview…'
  : m.source
    ? 'These files are hosted on Printables — open the link to download them.'
    : 'These files are hosted elsewhere — use the links to download them.';
---

<Base title={m.title} description={m.description || `${m.title} — 3D model`} section="rx7">
  <main>
    <div class="wrap">
      <a class="backlink" href={u('/rx7/models/')}>← All models</a>

      <div class="model-layout">
        {
          hasFile ? (
            <div class="viewer" id="viewer" data-src={fileUrl} data-ext={ext}>
              <p class="viewer__hint">{viewerNote}</p>
            </div>
          ) : (
            <div class="viewer viewer--external">
              <div class="viewer__external">
                <p class="viewer__hint">{viewerNote}</p>
              </div>
            </div>
          )
        }

        <aside class="model-meta">
          <p class="card__meta">
            {m.category ? <span class="pill">{m.category}</span> : <span>3D model</span>}
            <span>· {ext.toUpperCase()}</span>
          </p>

          <h1>{m.title}</h1>
          {m.description && <p class="muted">{m.description}</p>}

          {
            m.credit && (
              <p class="model-credit">
                Designed by <b>{m.credit}</b>
                {m.licence && (
                  <>
                    {' '}
                    · <a href={m.source || 'https://creativecommons.org/licenses/by-nc-nd/4.0/'}>{m.licence}</a>
                  </>
                )}
              </p>
            )
          }

          <div class="model-downloads">
            {
              source.map((f) => (
                <a
                  class={f.href === m.file ? 'btn' : 'btn btn--ghost'}
                  href={u(f.href)}
                  download={!/^https?:/.test(f.href)}
                  rel="noopener"
                >
                  {f.label}
                </a>
              ))
            }
            <a class="btn btn--ghost" href={u('/rx7/models/')}>All models</a>
          </div>

          {
            source.some((f) => f.note) && (
              <ul class="model-files">
                {source.map(
                  (f) =>
                    f.note && (
                      <li>
                        <span>{f.label.replace(/^Download /, '')}</span>
                        <span class="muted">{f.note}</span>
                      </li>
                    ),
                )}
              </ul>
            )
          }

          <p class="muted model-hint">
            Drag to orbit, scroll to zoom. Download the file to slice it for
            printing.
          </p>

          {
            m.source && hasFile && (
              <p class="muted model-hint">
                <a href={m.source} target="_blank" rel="noopener">
                  Original files and licence →
                </a>
              </p>
            )
          }
        </aside>
      </div>

      <div class="prose model-body">
        <Content />
      </div>
    </div>
  </main>

  <script>
    const host = document.getElementById('viewer');

    // The preview parses the STL on the main thread — the left cover is 1.7 MB
    // and doing that during load pushed TBT from 440ms to 7.6s (Lighthouse perf
    // 89 → 70). The page's text and images matter first; the mesh can wait for
    // an idle slot. The viewer keeps its aspect-ratio box meanwhile, so nothing
    // shifts when it arrives.
    //
    // three.js is imported dynamically inside this function: a model with no
    // local file (its files live on Printables) renders no #viewer at all, and
    // a static import would still ship ~155 KB of renderer to a page that can
    // never use it.
    const startViewer = async () => {
      if (!host) return;
      const src = host.dataset.src;
      const ext = (host.dataset.ext || 'stl').toLowerCase();

      const THREE = await import('three');
      const { OrbitControls } = await import('three/examples/jsm/controls/OrbitControls.js');
      const { STLLoader } = await import('three/examples/jsm/loaders/STLLoader.js');
      const { GLTFLoader } = await import('three/examples/jsm/loaders/GLTFLoader.js');

      try {
        const width = host.clientWidth || 640;
        const height = host.clientHeight || 480;

        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0x141416);

        const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 5000);
        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.setSize(width, height, false);
        host.replaceChildren(renderer.domElement);

        const key = new THREE.DirectionalLight(0xffffff, 2.4);
        key.position.set(1, 2, 3);
        scene.add(key, new THREE.AmbientLight(0xffffff, 0.9));

        const grid = new THREE.GridHelper(200, 40, 0x3f3f46, 0x27272b);
        grid.position.y = -0.001;
        scene.add(grid);

        const controls = new OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;
        controls.autoRotate = true;
        controls.autoRotateSpeed = 1.4;

        const finish = (geometry: THREE.BufferGeometry) => {
          geometry.computeVertexNormals();
          geometry.center();

          const box = new THREE.Box3().setFromObject(
            new THREE.Mesh(geometry, new THREE.MeshStandardMaterial()),
          );
          const size = box.getSize(new THREE.Vector3()).length();
          const mesh = new THREE.Mesh(
            geometry,
            new THREE.MeshStandardMaterial({
              color: 0xef4444,
              metalness: 0.25,
              roughness: 0.45,
            }),
          );
          scene.add(mesh);

          camera.position.set(size * 0.9, size * 0.6, size * 1.3);
          camera.near = size / 100;
          camera.far = size * 40;
          camera.updateProjectionMatrix();
          controls.target.set(0, 0, 0);
          controls.minDistance = size * 0.15;
          controls.maxDistance = size * 6;
          controls.update();
        };

        if (ext === 'stl') {
          new STLLoader().load(src, finish, undefined, () => fail(host));
        } else {
          const loader = new GLTFLoader();
          loader.load(
            src,
            (gltf) => {
              const box = new THREE.Box3().setFromObject(gltf.scene);
              const center = box.getCenter(new THREE.Vector3());
              gltf.scene.position.sub(center);
              scene.add(gltf.scene);
              const size = box.getSize(new THREE.Vector3()).length();
              camera.position.set(size * 0.9, size * 0.6, size * 1.3);
              controls.update();
            },
            undefined,
            () => fail(host),
          );
        }

        let raf = 0;
        const tick = () => {
          controls.update();
          renderer.render(scene, camera);
          raf = requestAnimationFrame(tick);
        };
        tick();

        const onResize = () => {
          const w = host.clientWidth;
          const h = host.clientHeight;
          if (!w || !h) return;
          camera.aspect = w / h;
          camera.updateProjectionMatrix();
          renderer.setSize(w, h, false);
        };
        window.addEventListener('resize', onResize);
        window.addEventListener('pagehide', () => cancelAnimationFrame(raf), { once: true });
      } catch {
        fail(host);
      }
    };

    const schedule = () => {
      if ('requestIdleCallback' in window) {
        (window as Window & { requestIdleCallback: (cb: () => void, o?: object) => void })
          .requestIdleCallback(startViewer, { timeout: 3000 });
      } else {
        setTimeout(startViewer, 1);
      }
    };
    if (document.readyState === 'complete') schedule();
    else window.addEventListener('load', schedule, { once: true });

    function fail(el: HTMLElement) {
      el.innerHTML =
        '<p class="viewer__hint">This model can\'t be previewed in your browser — use the download button.</p>';
    }
  </script>
</Base>

<style>
  .model-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 340px);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }

  .viewer {
    aspect-ratio: 4 / 3;
    width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-elev);
    display: grid;
    place-items: center;
  }

  .viewer :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .viewer__hint {
    color: var(--fg-muted);
    font-size: 0.92rem;
    margin: 0;
  }

  /* No local file: the panel says where the files are instead of showing a
     mesh. Keeps the 4/3 box so the sidebar never jumps when it renders. */
  .viewer__external {
    display: grid;
    gap: 1rem;
    justify-items: center;
    text-align: center;
    padding: 1.5rem;
    max-width: 34ch;
  }

  .viewer--external {
    background:
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 26px 26px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 26px 26px,
      var(--bg-elev);
  }

  .model-meta {
    position: sticky;
    top: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
    padding: 1.35rem;
    display: grid;
    gap: 0.9rem;
  }

  .model-meta h1 {
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    margin: 0;
  }

  .model-meta p {
    margin: 0;
  }

  .model-downloads {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .model-credit {
    font-size: 0.88rem;
    color: var(--fg-muted);
    border-left: 2px solid var(--accent);
    padding-left: 0.7rem;
  }

  .model-credit b {
    color: var(--fg);
    font-weight: 600;
  }

  .model-hint {
    font-size: 0.84rem;
  }

  /* What each download actually is: side, format, size. Sits under the
     buttons so the buttons stay a compact row. */
  .model-files {
    list-style: none;
    margin: 0;
    padding: 0.7rem 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 0.3rem;
    font-size: 0.8rem;
  }

  .model-files li {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: baseline;
  }

  .model-files li span:first-child {
    color: var(--fg);
    white-space: nowrap;
  }

  /* Specs, print caveats and the licence sit under the viewer: the sidebar
     already carries the downloads, and the table needs the full column width. */
  .model-body {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
    border-top: 1px solid var(--line);
    max-width: 74ch;
  }

  @media (max-width: 900px) {
    .model-layout {
      grid-template-columns: 1fr;
    }

    .model-meta {
      position: static;
    }
  }
</style>
