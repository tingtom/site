---
import { getCollection } from 'astro:content';
import { slug } from '../../../lib/slug';
import Base from '../../../layouts/Base.astro';
import { u } from '../../../lib/url';

export async function getStaticPaths() {
  const models = (await getCollection('models')).filter((m) =>
    m.data.sections.includes('rx7'),
  );
  return models.map((model) => ({
    params: { slug: slug(model) },
    props: { model },
  }));
}

const { model } = Astro.props;
const m = model.data;

const hasFile = Boolean(m.file);
const fileUrl = hasFile ? u(m.file) : '';
const ext = hasFile ? (m.file!.split('.').pop()?.toLowerCase() ?? 'stl') : '';

// Every downloadable part is its own row — label, note, link. `files` carries
// what the single `file` field cannot: the other side of a pair, STEP
// originals, a zip, print notes. A row may hold an uploaded file or a URL;
// the uploaded one wins when both are present.
//
// The previewed file always gets its own row, reusing the label and note from
// `files` when one points at it. Without that, adding any row to `files` would
// silently hide the local file: the list used to be `files` verbatim, so the
// primary download only appeared when `files` happened to be empty.
const listed = (m.files ?? []).map((f) => ({ ...f, href: f.file || f.href }));
const primaryFile = hasFile
  ? [listed.find((f) => f.href === m.file) ?? { label: ext.toUpperCase(), href: m.file!, note: '' }]
  : [];
const downloads = [...primaryFile, ...listed.filter((f) => f.href !== m.file)];

// The API hands back long-form licence names ("Creative Commons —
// Attribution — Noncommercial"); the headings want the short code. Data keeps
// whatever was recorded verbatim — only the display is shortened.
const licenceCode = (() => {
  const l = (m.licence || '').trim();
  if (!l) return '';
  if (/^CC[\s-]/i.test(l)) return l;
  const s = l.toLowerCase();
  if (s.includes('public domain') || s.includes('cc0')) return 'CC0';
  const t: string[] = [];
  if (s.includes('attribution')) t.push('by');
  if (s.includes('noncommercial')) t.push('nc');
  if (s.includes('no derivatives')) t.push('nd');
  if (s.includes('share alike')) t.push('sa');
  return t.length ? `CC ${t.join('-').toUpperCase()}` : l;
})();

const licenceUrl = (() => {
  const s = (m.licence || '').toLowerCase();
  if (!s) return '';
  if (s.includes('public domain') || s.includes('cc0'))
    return 'https://creativecommons.org/publicdomain/zero/1.0/';
  const t: string[] = [];
  if (s.includes('attribution')) t.push('by');
  if (s.includes('noncommercial')) t.push('nc');
  if (s.includes('no derivatives')) t.push('nd');
  if (s.includes('share alike')) t.push('sa');
  return t.length ? `https://creativecommons.org/licenses/${t.join('-')}/4.0/` : '';
})();

// What the licence actually forbids, so nobody has to decode the code. The
// stored value may be long form ("Creative Commons — Attribution —
// Noncommercial") or short ("CC BY-NC-ND 4.0"), so both are matched — checking
// only for the spelled-out words left the headlight covers with a single
// term when it should carry three.
const terms: string[] = [];
if (licenceCode) {
  const s = (m.licence || '').toLowerCase();
  const isCC0 = s.includes('public domain') || s.includes('cc0');
  const nc = s.includes('noncommercial') || /(^|[^a-z])nc([^a-z]|$)/.test(s);
  const nd = s.includes('no derivatives') || /(^|[^a-z])nd([^a-z]|$)/.test(s);
  const sa = s.includes('share alike') || /(^|[^a-z])sa([^a-z]|$)/.test(s);

  if (isCC0) {
    terms.push('No conditions — reuse it however you like.');
  } else {
    terms.push('Credit stays with the files.');
    if (nc) terms.push("Don't sell the files, or anything printed from them.");
    if (nd) terms.push('Unmodified copies only — no publishing or sharing a changed version.');
    if (sa) terms.push('Share any adaptation under this same licence.');
  }
}
---

<Base title={m.title} description={m.description || `${m.title} — 3D model`} section="rx7">
  <main>
    <div class="wrap">
      <a class="backlink" href={u('/rx7/models/')}>← All models</a>

      <div class="model-layout">
        <div class="model-preview">
          {
            hasFile ? (
              <div class="viewer" id="viewer" data-src={fileUrl} data-ext={ext}>
                <p class="viewer__hint">Loading 3D preview…</p>
              </div>
            ) : (
              <div class="viewer viewer--external">
                <div class="viewer__external">
                  <p class="viewer__hint">
                    {m.source
                      ? 'These files are hosted on Printables — get them from the link below.'
                      : 'These files are hosted elsewhere — use the links below.'}
                  </p>
                </div>
              </div>
            )
          }
          {hasFile && <p class="viewer__sub">Drag to orbit, scroll to zoom.</p>}
        </div>

        <aside class="model-meta">
          <p class="card__meta">
            {m.category ? <span class="pill">{m.category}</span> : <span>3D model</span>}
            {hasFile && <span>· {ext.toUpperCase()}</span>}
          </p>

          <h1>{m.title}</h1>
          {m.description && <p class="muted">{m.description}</p>}
          {m.notes && <p class="muted model-notes">{m.notes}</p>}

          {
            m.credit && (
              <p class="model-credit">
                Designed by <b>{m.credit}</b>
                {licenceCode && (
                  <>
                    {' '}
                    · <a href={licenceUrl || '#licence'}>{licenceCode}</a>
                  </>
                )}
              </p>
            )
          }
        </aside>
      </div>

      {
        downloads.length > 0 && (
          <section class="model-section">
            <div class="section-head">
              <h2>Models</h2>
            </div>
            <ul class="model-list">
              {downloads.map((f) => (
                <li>
                  <a
                    class="model-list__row"
                    href={u(f.href)}
                    download={!/^https?:/.test(f.href)}
                    rel="noopener"
                  >
                    <span class="model-list__name">{f.label}</span>
                    {f.note && <span class="model-list__note">{f.note}</span>}
                    <span class="model-list__arrow" aria-hidden="true">
                      ↓
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        licenceCode && (
          <section class="model-section" id="licence">
            <div class="section-head">
              <h2>Licence — {licenceCode}</h2>
              {
                m.source && (
                  <a class="btn" href={m.source} target="_blank" rel="noopener">
                    {m.source.includes('printables') ? 'View on Printables →' : 'Open original site →'}
                  </a>
                )
              }
            </div>
            <div class="licence">
              {m.credit && (
                <p>
                  Designed by <b>{m.credit}</b>.{' '}
                  {hasFile ? (
                    <>
                      These files are hosted here unmodified, exactly as published, under{' '}
                      <a href={licenceUrl} target="_blank" rel="noopener">
                        {licenceCode}
                      </a>
                      .
                    </>
                  ) : (
                    <>
                      Nothing is mirrored here — the link above takes you to the original
                      page, where the files and the licence live under{' '}
                      <a href={licenceUrl} target="_blank" rel="noopener">
                        {licenceCode}
                      </a>
                      .
                    </>
                  )}
                </p>
              )}
              {terms.length > 0 && (
                <ul class="licence__terms">
                  {terms.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              )}
            </div>
          </section>
        )
      }
    </div>
  </main>

  <script>
    const host = document.getElementById('viewer');

    // ?render=1 turns this page into a screenshot target for
    // scripts/render-model-previews.mjs: the viewer is pinned to the viewport,
    // everything else is hidden, and the auto-rotation stops so the frame is
    // deterministic. It runs the same code a visitor does, so a generated
    // preview cannot drift from the real one.
    //
    // The CSS ships with the flag rather than in a stylesheet: it only ever
    // applies here, and tying it to the same statement as the class means the
    // two can't disagree about whether render mode is on.
    const renderMode = new URLSearchParams(location.search).has('render');
    if (renderMode) {
      document.documentElement.classList.add('render-mode');
      document.head.insertAdjacentHTML(
        'beforeend',
        `<style>
          html.render-mode, html.render-mode body { overflow: hidden; margin: 0; }
          html.render-mode body * { visibility: hidden; }
          html.render-mode #viewer, html.render-mode #viewer * { visibility: visible; }
          html.render-mode #viewer {
            position: fixed; inset: 0; width: 100vw; height: 100vh;
            aspect-ratio: auto; border: 0; border-radius: 0;
          }
        </style>`,
      );
    }

    // The preview parses the STL on the main thread — the left cover is 1.7 MB
    // and doing that during load pushed TBT from 440ms to 7.6s (Lighthouse perf
    // 89 → 70). The page's text and images matter first; the mesh can wait for
    // an idle slot. The viewer keeps its aspect-ratio box meanwhile, so nothing
    // shifts when it arrives.
    //
    // three.js is imported dynamically inside this function: a model with no
    // local file (its files live on Printables) renders no #viewer at all, and
    // a static import would still ship ~155 KB of renderer to a page that can
    // never use it.
    const startViewer = async () => {
      if (!host) return;
      const src = host.dataset.src;
      const ext = (host.dataset.ext || 'stl').toLowerCase();

      const THREE = await import('three');
      const { OrbitControls } = await import('three/examples/jsm/controls/OrbitControls.js');
      const { STLLoader } = await import('three/examples/jsm/loaders/STLLoader.js');
      const { GLTFLoader } = await import('three/examples/jsm/loaders/GLTFLoader.js');

      try {
        const width = host.clientWidth || 640;
        const height = host.clientHeight || 480;

        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0x141416);

        const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 5000);
        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.setSize(width, height, false);
        host.replaceChildren(renderer.domElement);

        const key = new THREE.DirectionalLight(0xffffff, 2.4);
        key.position.set(1, 2, 3);
        scene.add(key);
        scene.add(new THREE.AmbientLight(0xffffff, 0.9));

        const controls = new OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;
        // Plain continuous rotation, as it was before. A bounded swing was
        // tried to keep the camera off the angles where this part reads as an
        // edge-on fin (90°/180° in a 12-angle render grid), but writing the
        // camera position every frame meant releasing a drag teleported it
        // back to the swing target — a visible jump — and continuous motion
        // was preferred regardless. The camera still STARTS at the angle where
        // the vent reads (-45° azimuth, 40° elevation), so the first frame and
        // any early screenshot are good; OrbitControls handles dragging itself.
        // Frozen in ?render mode, where a reproducible angle is the point.
        controls.autoRotate = !renderMode;
        controls.autoRotateSpeed = 1.4;

        // The direction the camera starts from: -45° azimuth, 40° elevation,
        // the angle these parts read at. Length is irrelevant — fit() scales
        // it — only the direction.
        const START_DIR = new THREE.Vector3(-0.54, 0.64, 0.54).normalize();

        // The floor. A fixed 200-unit grid was six times the trunk clip and
        // *smaller* than the headlight cover, so on the big parts the model
        // sat on a patch of grid floating inside itself. Size it from the
        // model instead, and drop it just under the lowest point: at y = 0 it
        // sliced every model in half, because the mesh is centred on the
        // origin.
        const layoutGrid = (box: THREE.Box3) => {
          const size = box.getSize(new THREE.Vector3());
          const maxDim = Math.max(size.x, size.y, size.z, 1e-6);
          const grid = new THREE.GridHelper(maxDim * 4, 40, 0x3f3f46, 0x27272b);
          // A hair below, or the bottom face and the grid are coplanar and
          // z-fight.
          grid.position.y = box.min.y - maxDim * 0.005;
          scene.add(grid);
        };

        // Frame the camera around a bounding box by *solving* for the
        // distance instead of guessing it. A sphere of radius R fits a
        // frustum of half-angle θ from R / sin θ away, and at 45° fov that
        // is 2.61 R — but the old code sat at the box diagonal, which is
        // exactly 2 R, so every model opened cropped. The armrest cupholder
        // lost the top third of itself; the headlight cover lost its top
        // edge and half of the right.
        //
        // Fitting the bounding *sphere* rather than the box matters because
        // autoRotate turns the camera through every azimuth: a distance that
        // just fits the box at the start angle lets the model slide out of
        // frame half a rotation later.
        const fit = (box: THREE.Box3) => {
          const sphere = box.getBoundingSphere(new THREE.Sphere());
          const radius = Math.max(sphere.radius, 1e-6);

          const vHalf = (camera.fov * Math.PI) / 360;
          const hHalf = Math.atan(Math.tan(vHalf) * camera.aspect);
          // The narrower of the two governs; on the 4/3 viewer that is always
          // the vertical, but a narrow window would flip it.
          const distance = (radius / Math.sin(Math.min(vHalf, hHalf))) * 1.08;

          camera.position.copy(sphere.center).addScaledVector(START_DIR, distance);
          camera.near = distance / 100;
          camera.far = distance * 40;
          camera.updateProjectionMatrix();

          controls.target.copy(sphere.center);
          controls.minDistance = distance * 0.15;
          controls.maxDistance = distance * 6;
          controls.update();

          layoutGrid(box);
        };

        const finish = (geometry: THREE.BufferGeometry) => {
          geometry.computeVertexNormals();
          geometry.center();

          const mesh = new THREE.Mesh(
            geometry,
            new THREE.MeshStandardMaterial({
              color: 0xef4444,
              metalness: 0.25,
              roughness: 0.45,
            }),
          );
          scene.add(mesh);
          fit(new THREE.Box3().setFromObject(mesh));
        };

        // glTF, 3MF and OBJ all arrive as a Group rather than a bare geometry,
        // so they skip the mesh/material step but share the framing. Without a
        // branch for each, every format other than STL was handed to
        // GLTFLoader and simply failed — which is how 3MF, common on
        // Printables, ended up unpreviewable.
        const frame = (object) => {
          const box = new THREE.Box3().setFromObject(object);
          const center = box.getCenter(new THREE.Vector3());
          object.position.sub(center);
          scene.add(object);

          // Shift the box by the same amount, so fit() sees it in the
          // coordinates the camera will actually look at.
          box.min.sub(center);
          box.max.sub(center);
          fit(box);
        };

        const onError = () => fail(host);

        if (ext === 'stl') {
          new STLLoader().load(src, finish, undefined, onError);
        } else if (ext === '3mf') {
          const { ThreeMFLoader } = await import(
            'three/examples/jsm/loaders/3MFLoader.js'
          );
          new ThreeMFLoader().load(src, frame, undefined, onError);
        } else if (ext === 'obj') {
          const { OBJLoader } = await import('three/examples/jsm/loaders/OBJLoader.js');
          new OBJLoader().load(src, frame, undefined, onError);
        } else if (ext === 'glb' || ext === 'gltf') {
          new GLTFLoader().load(src, (gltf) => frame(gltf.scene), undefined, onError);
        } else {
          fail(host, `.${ext} can't be previewed here — download it below.`);
        }

        let raf = 0;
        const tick = () => {
          controls.update();
          renderer.render(scene, camera);
          raf = requestAnimationFrame(tick);
        };
        tick();

        const onResize = () => {
          const w = host.clientWidth;
          const h = host.clientHeight;
          if (!w || !h) return;
          camera.aspect = w / h;
          camera.updateProjectionMatrix();
          renderer.setSize(w, h, false);
        };
        window.addEventListener('resize', onResize);
        window.addEventListener('pagehide', () => cancelAnimationFrame(raf), { once: true });
      } catch (err) {
        // Silent catches hide the reason the preview is missing, which is
        // exactly what happened when the swing change broke setup: the panel
        // said "can't be previewed" and nothing pointed at the cause.
        console.error('3D viewer failed:', err);
        fail(host);
      }
    };

    const schedule = () => {
      if ('requestIdleCallback' in window) {
        (window as Window & { requestIdleCallback: (cb: () => void, o?: object) => void })
          .requestIdleCallback(startViewer, { timeout: 3000 });
      } else {
        setTimeout(startViewer, 1);
      }
    };
    if (document.readyState === 'complete') schedule();
    else window.addEventListener('load', schedule, { once: true });

    // textContent rather than innerHTML: the unsupported-format message quotes
    // the file extension, which comes from an uploaded filename.
    function fail(el: HTMLElement, message?: string) {
      const text =
        message ??
        "This model can't be previewed in your browser — use the download links below.";
      el.textContent = '';
      const p = document.createElement('p');
      p.className = 'viewer__hint';
      p.textContent = text;
      el.appendChild(p);
    }
  </script>
</Base>

<style>
  .model-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 340px);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }

  /* Preview column: the viewer plus its caption, so the hint sits directly
     under the box it describes rather than in the sidebar. */
  .model-preview {
    display: grid;
    gap: 0.6rem;
    justify-items: stretch;
    min-width: 0;
  }

  .viewer {
    aspect-ratio: 4 / 3;
    width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-elev);
    display: grid;
    place-items: center;
  }

  .viewer :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .viewer__hint {
    color: var(--fg-muted);
    font-size: 0.92rem;
    margin: 0;
  }

  .viewer__sub {
    color: var(--fg-muted);
    font-size: 0.82rem;
    margin: 0;
    text-align: center;
  }

  /* No local file: the panel says where the files are instead of showing a
     mesh. Keeps the 4/3 box so the sidebar never jumps when it renders. */
  .viewer__external {
    display: grid;
    gap: 1rem;
    justify-items: center;
    text-align: center;
    padding: 1.5rem;
    max-width: 34ch;
  }

  .viewer--external {
    background:
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 26px 26px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 26px 26px,
      var(--bg-elev);
  }

  .model-meta {
    position: sticky;
    top: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
    padding: 1.35rem;
    display: grid;
    gap: 0.9rem;
  }

  .model-meta h1 {
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    margin: 0;
  }

  .model-meta p {
    margin: 0;
  }

  /* Print time, material, provenance — the second line under the
     description. Kept visually subordinate so it reads as a footnote to it
     rather than a second paragraph competing for attention. */
  .model-notes {
    font-size: 0.88rem;
    opacity: 0.85;
  }

  .model-credit {
    font-size: 0.88rem;
    color: var(--fg-muted);
    border-left: 2px solid var(--accent);
    padding-left: 0.7rem;
  }

  .model-credit b {
    color: var(--fg);
    font-weight: 600;
  }

  /* Downloads and licence each get their own full-width section beneath the
     preview and the text, instead of competing with the title in the sidebar. */
  .model-section {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
    border-top: 1px solid var(--line);
    max-width: 74ch;
  }

  .model-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .model-list li {
    border-bottom: 1px solid var(--line);
  }

  .model-list__row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.85rem 0.15rem;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s ease;
  }

  .model-list__row:hover {
    background: var(--bg-elev);
  }

  .model-list__name {
    font-weight: 600;
    color: var(--fg);
    white-space: nowrap;
  }

  .model-list__note {
    color: var(--fg-muted);
    font-size: 0.85rem;
    flex: 1;
  }

  .model-list__arrow {
    color: var(--accent);
    font-weight: 700;
    /* Pushed to the right edge by its own margin rather than by the note
       flexing: rows with no note (the strap-down entries) had nothing
       stretching, so the arrow sat right next to the label instead of at the
       end of the row. */
    margin-left: auto;
  }

  .licence p {
    margin: 0 0 0.9rem;
  }

  .licence__terms {
    margin: 0;
    padding-left: 1.15rem;
    color: var(--fg-muted);
    display: grid;
    gap: 0.35rem;
  }

  @media (max-width: 900px) {
    .model-layout {
      grid-template-columns: 1fr;
    }

    .model-meta {
      position: static;
    }

    .model-list__row {
      flex-wrap: wrap;
      gap: 0.35rem 1rem;
    }
  }
</style>
