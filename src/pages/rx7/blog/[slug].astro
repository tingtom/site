---
import { getCollection, render } from 'astro:content';
import { slug } from '../../../lib/slug';
import Base from '../../../layouts/Base.astro';
import { u } from '../../../lib/url';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter((p) => p.data.sections.includes('rx7'));
  const sorted = posts.slice().sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return sorted.map((post) => ({
    params: { slug: slug(post) },
    props: {
      post,
      more: sorted.filter((p) => slug(p) !== slug(post)).slice(0, 3),
    },
  }));
}

const { post, more } = Astro.props;
const { Content } = await render(post);
const date = new Date(post.data.date);
const formatted = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Base title={post.data.title} description={post.data.summary} section="rx7">
  <main>
    <div class="wrap wrap--narrow">
      <a class="backlink" href={u('/rx7/blog/')}>← RX7 blog</a>

      <article>
        <header class="page-head">
          <p class="card__meta">
            <time datetime={date.toISOString()}>{formatted}</time>
            {post.data.mins > 0 && <span>· {post.data.mins} min read</span>}
          </p>
          <h1>{post.data.title}</h1>
          {post.data.summary && <p>{post.data.summary}</p>}
        </header>

        <div class="prose">
          <Content />
        </div>
      </article>

      {
        more.length > 0 && (
          <aside style="margin-top: clamp(3rem, 7vw, 5rem)">
            <div class="section-head">
              <h2>More RX7 posts</h2>
            </div>
            <div class="grid grid--3">
              {more.map((p) => (
                <a class="card" href={u(`/rx7/blog/${slug(p)}/`)}>
                  <div class="card__body">
                    <h3 class="card__title">{p.data.title}</h3>
                  </div>
                </a>
              ))}
            </div>
          </aside>
        )
      }
    </div>
  </main>
</Base>
