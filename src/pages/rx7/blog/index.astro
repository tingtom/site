---
import { getCollection } from 'astro:content';
import { slug } from '../../../lib/slug';
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import { SECTIONS } from '../../../lib/nav';

const posts = (await getCollection('posts'))
  .filter((p) => p.data.sections.includes('rx7'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base
  title="RX7 blog"
  description={`RX7-related writing — ${posts.length} posts.`}
  section="rx7"
>
  <main>
    <div class="wrap">
      <header class="page-head">
        <p class="kicker">RX7</p>
        <h1>Blog</h1>
        <p>
          The RX7-filtered view of the blog.{' '}
          <a href="/personal/blog/">See everything I've written →</a>
        </p>
      </header>

      {
        posts.length ? (
          <div class="grid grid--3">
            {posts.map((p) => (
              <PostCard
                title={p.data.title}
                href={`/rx7/blog/${slug(p)}/`}
                date={p.data.date}
                mins={p.data.mins}
                summary={p.data.summary}
                headingLevel={2}
              />
            ))}
          </div>
        ) : (
          <div class="empty">No RX7 posts yet.</div>
        )
      }
    </div>
  </main>
</Base>
