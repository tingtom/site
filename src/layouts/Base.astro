---
import '../styles/global.css';
import { u, isActive } from '../lib/url';
import { SECTIONS, SOCIAL, SITE_NAME, type SectionId } from '../lib/nav';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/archivo/600.css';
import '@fontsource/archivo/700.css';
import '@fontsource/archivo/800.css';
import '@fontsource/archivo/900.css';

// The Latin subsets only — 91 KB of the 418 KB the CSS references. fontsource
// emits `font-display: swap`, so without a head start the browser paints in
// the fallback face and reflows when the webfont lands: that swap is the whole
// of the CLS Lighthouse reports on text-heavy pages. Preloading them lets the
// swap finish before first paint. The other 28 files (cyrillic, greek,
// vietnamese, latin-ext) stay lazy behind their unicode-range and are never
// fetched for an English page.
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import inter600 from '@fontsource/inter/files/inter-latin-600-normal.woff2?url';
import archivo600 from '@fontsource/archivo/files/archivo-latin-600-normal.woff2?url';
import archivo700 from '@fontsource/archivo/files/archivo-latin-700-normal.woff2?url';
import archivo800 from '@fontsource/archivo/files/archivo-latin-800-normal.woff2?url';

const FONT_PRELOADS = [
  { href: inter400, weight: '400' },
  { href: inter600, weight: '600' },
  { href: archivo600, weight: '600' },
  { href: archivo700, weight: '700' },
  { href: archivo800, weight: '800' },
];

interface Props {
  title: string;
  description?: string;
  section?: SectionId;
  ogImage?: string;
  /** Landing page renders its own chrome. */
  noChrome?: boolean;
}

const {
  title,
  description = 'Personal blog, projects, RX7 FD3S wiring diagrams and 3D models.',
  section = 'landing',
  ogImage = '/favicon.png',
  noChrome = false,
} = Astro.props;

const path = Astro.url.pathname;
const site = Astro.site ?? new URL('https://tingtom.github.io/site/');
const canonical = new URL(path.replace(/index\.html$/, ''), site).href;
const absImage = new URL(u(ogImage), site).href;
const active = section === 'personal' || section === 'rx7' ? SECTIONS[section] : null;
const other = active ? (active.id === 'personal' ? SECTIONS.rx7 : SECTIONS.personal) : null;
const pageTitle = title === SITE_NAME ? `${SITE_NAME} — personal projects & RX7` : `${title} · ${SITE_NAME}`;
const social = active ? SOCIAL[active.id] : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      // No u() here: Vite's ?url import already carries the deployed base,
      // so wrapping it again produced /site/site/… and 404'd every preload.
      FONT_PRELOADS.map((f) => (
        <link rel="preload" as="font" type="font/woff2" href={f.href} crossorigin />
      ))
    }
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absImage} />

    <link rel="icon" href={u('/favicon.png')} type="image/png" />
    <link rel="icon" href={u('/images/fav/favicon.ico')} sizes="32x32" />
    <link rel="icon" href={u('/images/fav/favicon-32x32.png')} sizes="32x32" />
    <link rel="icon" href={u('/images/fav/favicon-16x16.png')} sizes="16x16" />
    <link rel="apple-touch-icon" href={u('/images/fav/apple-touch-icon.png')} />
    <link
      rel="mask-icon"
      href={u('/images/fav/safari-pinned-tab.svg')}
      color={active?.id === 'rx7' ? '#ef4444' : '#0f766e'}
    />
    <link rel="manifest" href={u('/images/fav/site.webmanifest')} />
    <meta
      name="theme-color"
      content={active?.id === 'personal' ? '#efece2' : '#0a0a0b'}
    />
    {
      section === 'landing' && (
        <>
          {/* Both panel backdrops sit in the first paint and are LCP
              candidates — start them while the rest of the head streams by. */}
          <link rel="preload" as="image" href={u('/images/landing/personal.jpg')} fetchpriority="high" />
          <link rel="preload" as="image" href={u('/images/landing/rx7.jpg')} fetchpriority="high" />
        </>
      )
    }
  </head>

  <body data-section={section}>
    {!noChrome && active && (
      <header>
        <a class="brand" href={u('/')} aria-label={`${SITE_NAME} — home`}>{SITE_NAME}<span class="brand__dot" aria-hidden="true">.</span></a>

        <nav class="section-toggle" aria-label="Site sections">
          <a href={u(SECTIONS.personal.href)} aria-current={active.id === 'personal'}>
            {SECTIONS.personal.label}
          </a>
          <a href={u(SECTIONS.rx7.href)} aria-current={active.id === 'rx7'}>
            {SECTIONS.rx7.label}
          </a>
        </nav>

        <nav class="edge-tabs" aria-label={`${active.label} sections`}>
          {active.nav.map((item) => (
            <a href={u(item.href)} aria-current={isActive(path, item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </header>
    )}

    <slot />

    {!noChrome && active && (
      <footer class="site-foot">
        <div class="wrap">
          <nav aria-label="Footer">
            <a href={u(SECTIONS.personal.href)}>{SECTIONS.personal.label}</a>
            <a href={u(SECTIONS.rx7.href)}>{SECTIONS.rx7.label}</a>
          </nav>

          <div class="foot-meta">
            {active.id === 'rx7' && (
              <div class="logos">
                <a href="https://cults3d.com/en/users/tingtom" rel="me noopener" target="_blank">
                  <img
                    src={u('/logos/cults3d.png')}
                    alt="Cults3D"
                    width="173"
                    height="173"
                    loading="lazy"
                  />
                </a>
                <a href="https://www.printables.com/@tingtom" rel="me noopener" target="_blank">
                  <img
                    src={u('/logos/printables.png')}
                    alt="Printables"
                    width="847"
                    height="1212"
                    loading="lazy"
                  />
                </a>
              </div>
            )}

            {
              social && (
                <div class="social">
                  <a href={social.url} rel="me noopener" target="_blank" aria-label={social.label}>
                    <img
                      src={u(social.icon)}
                      alt=""
                      width="32"
                      height="32"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                </div>
              )
            }
          </div>

          <span>© {new Date().getFullYear()} {SITE_NAME}</span>
        </div>
      </footer>
    )}

    {!noChrome && !active && (
      <footer class="site-foot">
        <div class="wrap">
          <span>© {new Date().getFullYear()} {SITE_NAME}</span>
        </div>
      </footer>
    )}
    <script>
      // The top bar's hairline only means something once content has scrolled
      // under it — at the top of the page there is nothing to separate.
      const root = document.documentElement;
      const syncScroll = () => root.toggleAttribute('data-scrolled', window.scrollY > 2);
      syncScroll();
      window.addEventListener('scroll', syncScroll, { passive: true });
    </script>
  </body>
</html>
